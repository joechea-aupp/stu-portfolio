generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model users {
  id       String   @id @default(uuid()) @db.Char(36)
  name      String
  email     String   @unique
  password  String
  is_active Boolean  @default(true)
  user_type UserType @default(STUDENT)
  createdAt DateTime @default(now())
  student Student?
  administration Administration?
  kudos   StudentKudo[]
  user_roles UserRole[]
  assigned_achievement_verification_requests AchievementVerificationRequest[] @relation("AssignedAchievementVerifier")
  reviewed_achievement_verification_requests AchievementVerificationRequest[] @relation("ReviewedAchievementVerifier")
}

enum UserType {
  STUDENT
  ADMINISTRATION
}

enum Classification {
  FRESHMAN
  SOPHOMORE
  JUNIOR
  SENIOR
}

enum AdministrationTitle {
  MR
  MS
  DR
}

model Student {
  id String @id @default(uuid()) @db.Char(36)
  user_id String @unique @db.Char(36)
  major String
  graduation_year Int
  classification Classification
  available_for_project Boolean @default(false)
  kudo_count Int @default(0)
  view_count Int @default(0)
  summary String? @db.Text
  image_url String? @db.MediumText
  social_links Json?
  skills Json
  projects Json
  achievements Json
  // user create soley for typescript type safety and relation, authentication handled separately
  user   users         @relation(fields: [user_id], references: [id])
  kudos  StudentKudo[]
  achievement_verification_requests AchievementVerificationRequest[]

  @@map("students")
}

model AchievementVerificationRequest {
  id                       Int      @id @default(autoincrement())
  student_id               String   @db.Char(36)
  achievement_index        Int
  assigned_verifier_user_id String @db.Char(36)
  status                   String   @default("PENDING")
  requested_at             DateTime @default(now())
  reviewed_at              DateTime?
  reviewed_by_id           String? @db.Char(36)
  rejection_reason         String?  @db.Text
  student                  Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  assigned_verifier        users    @relation("AssignedAchievementVerifier", fields: [assigned_verifier_user_id], references: [id], onDelete: Cascade)
  reviewed_by              users?   @relation("ReviewedAchievementVerifier", fields: [reviewed_by_id], references: [id], onDelete: SetNull)

  @@index([student_id, status], map: "avr_student_status_idx")
  @@index([assigned_verifier_user_id, status], map: "avr_verifier_status_idx")
  @@index([requested_at], map: "avr_requested_at_idx")
  @@map("achievement_verification_requests")
}

model Administration {
  id              String              @id @default(uuid()) @db.Char(36)
  user_id         String              @unique @db.Char(36)
  occupation      String
  company         String
  phone_number    String
  gender          String
  summary         String              @db.Text
  profile_pic_url String              @db.MediumText
  title           AdministrationTitle
  user            users               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("administrations")
}

model StudentKudo {
  id         Int     @id @default(autoincrement())
  user_id    String  @db.Char(36)
  student_id String  @db.Char(36)
  user       users   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([user_id, student_id])
  @@map("student_kudos")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?          @db.Text
  is_system   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  label       String
  description String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            Int        @id @default(autoincrement())
  role_id       Int
  permission_id Int
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  user_id   String   @db.Char(36)
  role_id   Int
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([user_id])
  @@unique([user_id, role_id])
  @@map("user_roles")
}