generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model users {
  id       Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  is_active Boolean  @default(true)
  user_type UserType @default(STUDENT)
  administration_role AdministrationRole?
  can_assign_roles Boolean @default(false)
  createdAt DateTime @default(now())
  student Student?
  administration Administration?
  kudos   StudentKudo[]
}

enum UserType {
  STUDENT
  ADMINISTRATION
}

enum AdministrationRole {
  ADMIN_SUPER
  ADMIN_MANAGER
  ADMIN_STAFF
}

enum Classification {
  FRESHMAN
  SOPHOMORE
  JUNIOR
  SENIOR
}

enum AdministrationTitle {
  MR
  MS
  DR
}

model Student {
  id Int @id @default(autoincrement())
  user_id Int @unique
  major String
  graduation_year Int
  classification Classification
  available_for_project Boolean @default(false)
  kudo_count Int @default(0)
  view_count Int @default(0)
  summary String? @db.Text
  image_url String? @db.MediumText
  social_links Json?
  skills Json
  projects Json
  achievements Json
  // user create soley for typescript type safety and relation, authentication handled separately
  user   users         @relation(fields: [user_id], references: [id])
  kudos  StudentKudo[]

  @@map("students")
}

model Administration {
  id              Int                 @id @default(autoincrement())
  user_id         Int                 @unique
  occupation      String
  company         String
  phone_number    String
  gender          String
  summary         String              @db.Text
  profile_pic_url String              @db.MediumText
  title           AdministrationTitle
  user            users               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("administrations")
}

model StudentKudo {
  id         Int     @id @default(autoincrement())
  user_id    Int
  student_id Int
  user       users   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([user_id, student_id])
  @@map("student_kudos")
}